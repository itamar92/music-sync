# Container stack config — copy to .env (gitignored) and fill in.
#   copy .env.docker.example .env
#
# Used by docker-compose.yml (local dev stack) and docker-compose.deploy.yml
# (smart-home deploy). Never commit the filled-in .env.

# --- Postgres ---------------------------------------------------------------
POSTGRES_USER=musicsync
POSTGRES_DB=musicsync
POSTGRES_PASSWORD=

# --- Dropbox ----------------------------------------------------------------
# App key/secret from the Dropbox app console. DROPBOX_REFRESH_TOKEN is the only
# credential the backend needs at runtime — provision it once with
# generate-refresh-token.js (see SETUP_REFRESH_TOKEN.md). Without it the stack
# still boots, but /api/status reports hasToken:false and nothing can stream.
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=

# --- Admin login (/admin) ---------------------------------------------------
# JWT_SECRET signs admin sessions — use a long random string.
# Set ADMIN_PASSWORD_HASH (bcrypt) in production; ADMIN_PASSWORD is a plaintext
# fallback. If both are set, the hash wins.
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD=

# --- Local dev stack only ---------------------------------------------------
# Host port docker-compose.yml publishes the frontend on.
HTTP_PORT=8090

# Only used by the optional `tunnel` profile in docker-compose.yml. The deploy
# stack uses ./cloudflared/config.yml instead.
CLOUDFLARE_TUNNEL_TOKEN=
