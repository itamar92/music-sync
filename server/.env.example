# Backend config. In container mode these come from the stack's .env via
# docker-compose; this file is only for running `npm run dev` inside server/.

PORT=8080

# Postgres connection string
DATABASE_URL=postgres://musicsync:changeme@localhost:5432/musicsync

# Dropbox app credentials + the long-lived refresh token (see SETUP_REFRESH_TOKEN.md).
# The refresh token is the ONLY Dropbox credential the backend needs at runtime.
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=

# Admin login. Set ADMIN_PASSWORD_HASH (bcrypt) in production; ADMIN_PASSWORD is
# a plaintext fallback for local development only.
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD=

# Only needed when the frontend runs on a different origin (e.g. vite on :5173).
ALLOWED_ORIGINS=
